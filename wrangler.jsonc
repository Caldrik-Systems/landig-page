{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landig-page",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "custom_domains": ["caldrik.co", "www.caldrik.co"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
